# Copy this file to .env and fill in your values

# Sarvam AI — English transcription (translate mode, speaker diarization).
# Get keys from: https://dashboard.sarvam.ai/
#
# Comma-separated list. When one key runs out of credit the pipeline moves to
# the next one automatically. Example: SARVAM_API_KEYS=key_one,key_two
SARVAM_API_KEYS=your_sarvam_api_key_here

# Videos over 60 minutes are auto-chunked into fixed 60-min audio segments
# before transcription (each Sarvam job stays comfortably sized, and a
# credit failure only costs the current chunk, not the whole file). Override
# only if you have a reason to use a different chunk size.
# SARVAM_CHUNK_MINUTES=60

# OpenAI — used by the context stage (src/context.js) for BOTH the text-only
# scan (which lines need the screen) and the vision pen picture of each frame.
# Must be a vision-capable model that supports JSON response format.
# Get your key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Optional: transcript lines per context-scan call (default 150).
# CONTEXT_SCAN_BATCH_LINES=150

# NOTE: screen context needs the ORIGINAL video in input/ when the pipeline
# runs. Keep it there until the recording is finished; without it the
# transcript is still written, just without screen context.

# Optional: override default input/output paths
# INPUT_DIR=./input
# AUDIO_DIR=./audio
# OUTPUT_DIR=./output

# Optional: number of speakers in meetings (max 20, default 8)
# NUM_SPEAKERS=8

# Optional: budget-estimate rates (defaults shown). The estimate covers only
# work still pending — finished recordings cost ₹0.
#   SARVAM_PRICE_PER_HOUR_INR=45
#   USD_INR_RATE=95.4
#   OPENAI_PRICE_INPUT_PER_M=0.20        (USD per 1M tokens)
#   OPENAI_PRICE_OUTPUT_PER_M=1.20
#   OPENAI_ASSUMED_FRAMES_PER_SESSION=10
# Skip the budget prompt in automation: npm run pipeline -- --yes
