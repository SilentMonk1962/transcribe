# Copy this file to .env and fill in your values

# Sarvam AI — English transcription (translate mode, speaker diarization).
# Get keys from: https://dashboard.sarvam.ai/
#
# Preferred: comma-separated list of keys. All Sarvam calls share this pool — if one key runs out of credits mid-run, the
# pipeline automatically rotates to the next key in the list instead of
# stopping. Example:
#   SARVAM_API_KEYS=key_one,key_two,key_three
SARVAM_API_KEYS=your_sarvam_api_key_here

# Legacy fallbacks (still supported for backward compatibility, read only when
# SARVAM_API_KEYS is empty):
#   SARVAM_API_KEY=your_sarvam_api_key_here
#   SARVAM_API_KEY_FALLBACK=your_fallback_sarvam_api_key_here

# Videos over 60 minutes are auto-chunked into fixed 60-min audio segments
# before transcription (each Sarvam job stays comfortably sized, and a
# credit failure only costs the current chunk, not the whole file). Override
# only if you have a reason to use a different chunk size.
# SARVAM_CHUNK_MINUTES=60

# OpenAI — used for BOTH screen-context stages:
#   Stage 4 (src/context-scan.js)   text-only scan: which lines need the screen
#   Stage 6 (src/frame-describe.js) vision: pen picture of each captured frame
# Must be a vision-capable model that supports JSON response format.
# Get your key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Optional: transcript lines per context-scan call (default 150).
# CONTEXT_SCAN_BATCH_LINES=150

# NOTE: screen context needs the ORIGINAL video to still be in input/ when
# the pipeline runs. If it is gone, the transcript is still written and its
# header says "screen context unavailable".

# Optional: override default input/output paths
# INPUT_DIR=./input
# AUDIO_DIR=./audio
# OUTPUT_DIR=./output

# Optional: number of speakers in meetings (max 20, default 8)
# NUM_SPEAKERS=8

# Optional: budget-estimate knobs for the pre-run consent prompt
# ("npm run pipeline" probes input/ and asks before spending anything).
# Rates + heuristics, with the current defaults baked in:
#   SARVAM_PRICE_PER_HOUR_INR=45
#   USD_INR_RATE=95.4
#   OPENAI_PRICE_INPUT_PER_M=0.20
#   OPENAI_PRICE_OUTPUT_PER_M=1.20
#   SPOKEN_TOKENS_PER_MIN=180
#   SCAN_PROMPT_OVERHEAD_TOKENS=1200
#   SCAN_LINES_PER_MIN=4
#   SCAN_OUTPUT_TOKENS_PER_SESSION=500
#   OPENAI_ASSUMED_FRAMES_PER_SESSION=10
#   OPENAI_IMAGE_INPUT_TOKENS=500
#   OPENAI_TEXT_INPUT_TOKENS_PER_FRAME=150
#   OPENAI_CAPTION_OUTPUT_TOKENS=100
# To skip the prompt in automation: npm run pipeline -- --yes
