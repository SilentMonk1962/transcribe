# Copy this file to .env and fill in your values

# Sarvam AI — transcription (English translate by default; optional Hinglish
# codemix) AND the pure-English pass.
# Get keys from: https://dashboard.sarvam.ai/
#
# Preferred: comma-separated list of keys. All Sarvam calls (transcribe AND
# pure-english) share this pool — if one key runs out of credits mid-run, the
# pipeline automatically rotates to the next key in the list instead of
# stopping. Example:
#   SARVAM_API_KEYS=key_one,key_two,key_three
SARVAM_API_KEYS=your_sarvam_api_key_here

# Legacy fallbacks (still supported for backward compatibility, read only when
# SARVAM_API_KEYS is empty):
#   SARVAM_API_KEY=your_sarvam_api_key_here
#   SARVAM_API_KEY_FALLBACK=your_fallback_sarvam_api_key_here
#
# NOTE: the old SARVAM_TRANSLATE_API_KEY is gone — the pure-English pass now
# uses the same shared key pool as transcription.

# DEFAULT: runs ONLY the English "translate" pass. The codemix (Hinglish
# verbatim) pass is consumed by no downstream stage, so translate-only halves
# billed audio-minutes with no impact on notes. Set to 0 (or false) to ALSO
# run the codemix pass. Also honored by merge-chunks.
# SARVAM_TRANSLATE_ONLY=0

# Videos over 60 minutes are auto-chunked into fixed 60-min audio segments
# before transcription (each Sarvam job stays comfortably sized, and a
# credit failure only costs the current chunk, not the whole file). Override
# only if you have a reason to use a different chunk size.
# SARVAM_CHUNK_MINUTES=60

# DeepSeek — meeting-notes drafting + patch pass
# Get your key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI — used only for independent frame captioning (Stage 4 of vision-assist,
# src/vision-caption.js). Cheapest vision-capable tier confirmed as GPT-5.6 Luna
# on 2026-07-15 — re-verify at platform.openai.com/docs/models before relying on
# this if it's been a while; just change OPENAI_MODEL below if it's changed.
# Get your key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Optional: override default input/output paths
# INPUT_DIR=./input
# AUDIO_DIR=./audio
# OUTPUT_DIR=./output

# Optional: number of speakers in meetings (max 20, default 8)
# NUM_SPEAKERS=8

# Optional: budget-estimate knobs for the pre-run consent prompt
# ("npm run pipeline" probes input/ and asks before spending anything).
# Rates + heuristics, with the current defaults baked in:
#   SARVAM_PRICE_PER_HOUR_INR=45
#   USD_INR_RATE=95.4
#   DEEPSEEK_PRICE_INPUT_PER_M=0.435
#   DEEPSEEK_PRICE_OUTPUT_PER_M=0.87
#   OPENAI_PRICE_INPUT_PER_M=0.20
#   OPENAI_PRICE_OUTPUT_PER_M=1.20
#   SPOKEN_TOKENS_PER_MIN=180
#   DEEPSEEK_CALLS_PER_SESSION=3
#   DEEPSEEK_PROMPT_OVERHEAD_TOKENS=1500
#   DEEPSEEK_OUTPUT_TOKENS_PER_SESSION=4000
#   OPENAI_ASSUMED_FRAMES_PER_SESSION=2
#   OPENAI_IMAGE_INPUT_TOKENS=500
#   OPENAI_TEXT_INPUT_TOKENS_PER_FRAME=50
#   OPENAI_CAPTION_OUTPUT_TOKENS=150
# To skip the prompt in automation: npm run pipeline -- --yes
